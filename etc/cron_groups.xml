<?xml version="1.0"?>
<!--
  ~ Angeo LLMs.txt — dedicated cron group (3.1.1).
  ~
  ~ Generation on a large catalog can run for many minutes; running it inside
  ~ the "default" group would block every other default-group job (emails,
  ~ scheduled indexers, etc.) for that whole time. A dedicated group with
  ~ use_separate_process=1 forks generation into its own PHP process.
  -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/cron_groups.xsd">
    <group id="angeo_llms">
        <schedule_generate_every>15</schedule_generate_every>
        <schedule_ahead_for>20</schedule_ahead_for>
        <schedule_lifetime>120</schedule_lifetime>
        <history_cleanup_every>30</history_cleanup_every>
        <history_success_lifetime>180</history_success_lifetime>
        <history_failure_lifetime>4320</history_failure_lifetime>
        <use_separate_process>1</use_separate_process>
    </group>
</config>
