<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="angeo_llms" xsi:type="array">
                    <item name="class"     xsi:type="string">Angeo\LlmsTxt\Controller\Router</item>
                    <item name="disable"   xsi:type="boolean">false</item>
                    <!-- 70 = after urlrewrite (20), standard (30), and cms (60):
                         real merchant content always takes precedence; this router
                         only claims paths that would otherwise 404. -->
                    <item name="sortOrder" xsi:type="string">70</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
